{
    "openapi": "3.0.0",
    "info": {
        "title": "API Mash",
        "description": "Documentação da API RESTful do Mash",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Servidor local de desenvolvimento"
        }
    ],
    "paths": {
        "/login": {
            "post": {
                "summary": "Autenticação do usuário",
                "tags": [
                    "login"
                ],
                "requestBody": {
                    "required": true,
                    "description": "Requisição",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "joaoa@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "12345"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Autenticação realizada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "example": "<token JWT retornado pelo login>"
                                        },
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "number",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "joao"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "joao@gmail.com"
                                                },
                                                "urlImage": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "example": null
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "E-mail e senha não podem estar vazios",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "error"
                                    ],
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "E-mail e senha não podem estar vazios"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "E-mail ou senha inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "error"
                                    ],
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "E-mail ou senha inválidos"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno do servidor",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "error"
                                    ],
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Erro interno do servidor"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Nas rotas protegidas, envie Authorization: Bearer <token>."
            }
        }
    }
}
