    "/recipes/{id}/temperatures": {
      "get": {
        "summary": "Listar rampas em ordem de orderRamp e id",
        "tags": ["recipes"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["temperatures"],
                  "properties": {
                    "temperatures": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "maxTemperatureRamp": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "minTemperatureRamp": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "maxTemperatureLimit": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "minTemperatureLimit": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "timer": {
                            "type": "string",
                            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
                            "example": "00:10:00"
                          },
                          "initialization": {
                            "type": "string",
                            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
                            "example": "00:10:00"
                          },
                          "idealTime": {
                            "type": "string",
                            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
                            "example": "00:10:00"
                          },
                          "orderRamp": {
                            "type": "integer",
                            "minimum": -2147483648,
                            "maximum": 2147483647
                          },
                          "id": {
                            "type": "integer"
                          },
                          "recipeId": {
                            "type": "integer"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID ou campos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
