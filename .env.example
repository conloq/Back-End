# development no .env local; production no Render.
# Só development deixa o Cloudinary opcional e libera o npm run db:seed.
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:4000

# Banco (obrigatórias: DB_HOST, DB_USERNAME, DB_DATABASE)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=
DB_DATABASE=mash

# Obrigatória
JWT_SECRET_KEY=

# Cloudinary: obrigatórias fora de development; em development, vazias desativam só a troca de foto
CLOUD_NAME=
API_KEY_CLOUDINARY=
API_SECRET_KEY_CLOUDINARY=
